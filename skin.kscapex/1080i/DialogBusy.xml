<?xml version="1.0" encoding="UTF-8"?>
<!-- KScapeX: discreet. Nothing at all for the first 1.5 s, so starting a video never flashes a
     logo on black; a real wait (long loads) then shows a small, faint KScape logo bottom right,
     with no veil. The 10 s watchdog (busytimeout) stays. -->
<window>
	<depth>DepthMax</depth>
	<onload>AlarmClock(kscapebusy,RunScript(script.kscapex.wall,busytimeout),00:10,silent)</onload>
	<onunload>CancelAlarm(kscapebusy,silent)</onunload>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="image">
				<description>Small KScape logo, bottom right, only if the wait outlasts 1.5 s</description>
				<left>1572</left>
				<top>974</top>
				<width>300</width>
				<height>56</height>
				<aspectratio>keep</aspectratio>
				<texture colordiffuse="A0FFFFFF">kscape-logo.png</texture>
				<visible>!Window.IsActive(startup)</visible>
				<animation effect="fade" start="0" end="100" delay="1500" time="400">Visible</animation>
				<animation effect="fade" start="100" end="40" time="900" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
			</control>
		</control>
	</controls>
</window>
