<?xml version="1.0" encoding="UTF-8"?>
<!-- Video browser. View 50 is the cover wall for library titles (movies, TV shows, sets,
     seasons) and, KScapeX, a one-column list for everything else: sources, shares, folders and
     files (Home > System > Videos), library nodes. The two sets of layouts have opposite
     conditions: Kodi re-picks a container's layouts only when the condition of the one in use
     changes, so the list layouts must not be unconditional. -->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<views>50</views>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="image">
				<description>Background</description>
				<width>1920</width>
				<height>1080</height>
				<texture>background.png</texture>
			</control>

			<control type="panel" id="50">
				<description>Cover wall</description>
				<left>30</left>
				<top>20</top>
				<width>1870</width>
				<height>1000</height>
				<!-- Kodi wraps a container when an edge action is empty or points at itself. Pointing at
				     the never-visible control 59 makes the wall stop at its edges instead. -->
				<!-- Never put a <visible> condition on this view: Kodi only fills visible views, so hiding
				     it while empty leaves it empty forever. The lone ".." card is hidden in the layouts. -->
				<onup>59</onup>
				<ondown>59</ondown>
				<onleft>59</onleft>
				<onright>59</onright>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">220</scrolltime>
				<preloaditems>2</preloaditems>
				<viewtype label="31012">panel</viewtype>
				<itemlayout width="170" height="250" condition="[String.StartsWith(Container.FolderPath,videodb://) | String.StartsWith(Container.FolderPath,library://)] + [Container.Content(movies) | Container.Content(tvshows) | Container.Content(sets) | Container.Content(seasons) | Container.Content(musicvideos)]">
					<control type="group">
						<visible>!ListItem.IsParentFolder | Integer.IsGreater(Container(50).NumItems,0)</visible>
						<include content="PosterCard">
							<param name="tint" value="FFD0D0D0"/>
						</include>
					</control>
				</itemlayout>
				<focusedlayout width="170" height="250" condition="[String.StartsWith(Container.FolderPath,videodb://) | String.StartsWith(Container.FolderPath,library://)] + [Container.Content(movies) | Container.Content(tvshows) | Container.Content(sets) | Container.Content(seasons) | Container.Content(musicvideos)]">
					<control type="group">
						<description>Kodi adds ".." to empty listings even with parent items off; draw nothing for it.</description>
						<visible>!ListItem.IsParentFolder | Integer.IsGreater(Container(50).NumItems,0)</visible>
						<animation effect="zoom" start="100" end="108" center="80,120" time="180" tween="cubic" easing="out" condition="!Skin.HasSetting(ReducedMotion)">Focus</animation>
						<control type="image">
							<description>Soft shadow</description>
							<left>-30</left>
							<top>-22</top>
							<width>220</width>
							<height>300</height>
							<texture border="32">shadow.png</texture>
						</control>
						<control type="image">
							<description>Focus frame (always visible, also with reduced motion)</description>
							<left>-3</left>
							<top>-3</top>
							<width>166</width>
							<height>246</height>
							<texture colordiffuse="FFF2F2F2">white.png</texture>
						</control>
						<include content="PosterCard"/>
					</control>
				</focusedlayout>
				<!-- KScapeX: list rows (sources, folders, files): name on the left, Kodi's label2 (size,
				     date...) on the right; ".." stays, as the way up a share. -->
				<itemlayout width="1860" height="62" condition="![[String.StartsWith(Container.FolderPath,videodb://) | String.StartsWith(Container.FolderPath,library://)] + [Container.Content(movies) | Container.Content(tvshows) | Container.Content(sets) | Container.Content(seasons) | Container.Content(musicvideos)]]">
					<control type="label">
						<left>24</left>
						<width>1290</width>
						<height>62</height>
						<aligny>center</aligny>
						<font>kscape_list_row</font>
						<textcolor>kscape_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>1330</left>
						<width>506</width>
						<height>62</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>kscape13</font>
						<textcolor>kscape_text_dim</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</itemlayout>
				<focusedlayout width="1860" height="62" condition="![[String.StartsWith(Container.FolderPath,videodb://) | String.StartsWith(Container.FolderPath,library://)] + [Container.Content(movies) | Container.Content(tvshows) | Container.Content(sets) | Container.Content(seasons) | Container.Content(musicvideos)]]">
					<control type="image">
						<top>3</top>
						<width>1860</width>
						<height>56</height>
						<texture colordiffuse="kscape_blue_focus">white.png</texture>
						<visible>Control.HasFocus(50)</visible>
					</control>
					<control type="label">
						<left>24</left>
						<width>1290</width>
						<height>62</height>
						<aligny>center</aligny>
						<font>kscape_list_row</font>
						<textcolor>white</textcolor>
						<scroll>true</scroll>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="label">
						<left>1330</left>
						<width>506</width>
						<height>62</height>
						<align>right</align>
						<aligny>center</aligny>
						<font>kscape13</font>
						<textcolor>white</textcolor>
						<label>$INFO[ListItem.Label2]</label>
					</control>
				</focusedlayout>
			</control>

			<control type="button" id="59">
				<description>Edge stop target for the wall (never focusable)</description>
				<visible>false</visible>
			</control>

			<control type="group">
				<description>Info strip</description>
				<left>40</left>
				<top>1028</top>
				<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
				<control type="grouplist">
					<description>Title truncates first so year/genre/runtime stay visible</description>
					<width>1500</width>
					<height>40</height>
					<orientation>horizontal</orientation>
					<itemgap>0</itemgap>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="label">
						<width max="860">auto</width>
						<height>40</height>
						<aligny>center</aligny>
						<font>kscape13</font>
						<textcolor>FFF2F2F2</textcolor>
						<label>$VAR[WallTitleLabel]</label>
					</control>
					<control type="label">
						<width max="640">auto</width>
						<height>40</height>
						<aligny>center</aligny>
						<font>kscape13</font>
						<textcolor>FF9A9AA2</textcolor>
						<label>$VAR[WallMetaLabel]</label>
					</control>
				</control>
				<control type="label">
					<left>1540</left>
					<width>300</width>
					<height>40</height>
					<align>right</align>
					<aligny>center</aligny>
					<font>kscape_small</font>
					<textcolor>FF808088</textcolor>
					<label>$INFO[Container(50).CurrentItem]$INFO[Container(50).NumItems, / ]</label>
				</control>
			</control>

			<control type="group">
				<description>Empty and loading states</description>
				<left>360</left>
				<top>460</top>
				<control type="label">
					<width>1200</width>
					<height>60</height>
					<align>center</align>
					<font>kscape_title</font>
					<textcolor>FFE6E6EA</textcolor>
					<label>$LOCALIZE[31010]</label>
					<visible>Integer.IsEqual(Container(50).NumItems,0) + !Container.IsUpdating</visible>
				</control>
				<control type="label">
					<top>80</top>
					<width>1200</width>
					<height>40</height>
					<align>center</align>
					<font>kscape13</font>
					<textcolor>FF808088</textcolor>
					<label>$LOCALIZE[31011]</label>
					<visible>Integer.IsEqual(Container(50).NumItems,0) + !Container.IsUpdating</visible>
				</control>
				<control type="label">
					<top>40</top>
					<width>1200</width>
					<height>40</height>
					<align>center</align>
					<font>kscape13</font>
					<textcolor>FF808088</textcolor>
					<label>$LOCALIZE[31015]</label>
					<visible>Container.IsUpdating + Integer.IsEqual(Container(50).NumItems,0)</visible>
				</control>
			</control>
	
		</control>
	</controls>
</window>
