<?xml version="1.0" encoding="UTF-8"?>
<!-- Playback controls (OK / Menu during a movie). First row: Audio and Subtitles cycle in place.
     Second row (KScapeX, Down from the first): the technical data first (TinyPPI when installed,
     else DialogPlayerProcessInfo.xml, top left; the button toggles either), then Kodi's audio, video and
     subtitle settings dialogs (DialogSettings.xml), subtitle download (DialogSubtitles.xml),
     bookmarks and chapters (VideoOSDBookmarks.xml) and the movie's information
     (DialogFullScreenInfo.xml). Process info and information close the OSD first.
     Scenes (script.kscapex.wall): Mark scene start / end for a library movie or episode. During a
     scene or Demo Script (Home property kscape.demo.active, set by the add-on's service) the
     title line names the scene and its movie, the line above it the script and scene progress,
     and Previous scene / Next scene / Keep watching (leave demo mode, play on) replace the audio
     and subtitle buttons. -->
<window>
	<defaultcontrol always="true">101</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<control type="group">
			<description>Display &amp; aspect ratio root (Includes_Display.xml)</description>
			<include>KScapeDisplay</include>
			<control type="group">
				<animation effect="fade" start="0" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="140">WindowClose</animation>
				<control type="image">
					<top>654</top>
					<width>1920</width>
					<height>426</height>
					<texture colordiffuse="D8060607">white.png</texture>
				</control>
				<control type="label">
					<left>120</left>
					<top>696</top>
					<width>1400</width>
					<height>56</height>
					<font>kscape_panel_title</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$VAR[OSDTitleLabel]</label>
				</control>
				<control type="label">
					<description>Demo Script and scene progress (only while scenes play)</description>
					<left>120</left>
					<top>662</top>
					<width>1680</width>
					<height>30</height>
					<font>kscape_badge</font>
					<textcolor>kscape_amber</textcolor>
					<label>$INFO[Window(Home).Property(kscape.demo.script),,  ·  ]$INFO[Window(Home).Property(kscape.demo.progress)]</label>
					<visible>!String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
				</control>
				<control type="label">
					<left>1500</left>
					<top>696</top>
					<width>300</width>
					<height>56</height>
					<align>right</align>
					<font>kscape13</font>
					<textcolor>FF9A9AA2</textcolor>
					<label>$INFO[Player.FinishTime,$LOCALIZE[31029] ]</label>
				</control>
				<control type="progress">
					<left>120</left>
					<top>774</top>
					<width>1680</width>
					<height>8</height>
					<info>Player.Progress</info>
					<texturebg colordiffuse="40FFFFFF">white.png</texturebg>
					<midtexture colordiffuse="kscape_amber">white.png</midtexture>
				</control>
				<control type="label">
					<left>120</left>
					<top>792</top>
					<width>600</width>
					<height>40</height>
					<font>kscape_small</font>
					<textcolor>FFD0D0D8</textcolor>
					<label>$INFO[Player.Time]</label>
				</control>
				<control type="label">
					<left>1200</left>
					<top>792</top>
					<width>600</width>
					<height>40</height>
					<align>right</align>
					<font>kscape_small</font>
					<textcolor>FFD0D0D8</textcolor>
					<label>$INFO[Player.Duration]</label>
				</control>
				<control type="grouplist" id="100">
					<left>120</left>
					<top>864</top>
					<width>1680</width>
					<height>70</height>
					<orientation>horizontal</orientation>
					<itemgap>16</itemgap>
					<align>center</align>
					<ondown>200</ondown>
					<!-- KScapeX: Stop first (far left); the OSD still opens on Play (defaultcontrol 101) -->
					<control type="button" id="106">
						<include content="OSDButton"><param name="width" value="200"/></include>
						<label>$LOCALIZE[31027]</label>
						<onclick>PlayerControl(Stop)</onclick>
					</control>
					<control type="button" id="101">
						<include content="OSDButton"><param name="width" value="200"/></include>
						<label>$VAR[OSDPlayPauseLabel]</label>
						<onclick>PlayerControl(Play)</onclick>
					</control>
					<control type="button" id="102">
						<include content="OSDButton"><param name="width" value="180"/></include>
						<label>$LOCALIZE[31022]</label>
						<onclick>Seek(-30)</onclick>
					</control>
					<control type="button" id="103">
						<include content="OSDButton"><param name="width" value="180"/></include>
						<label>$LOCALIZE[31023]</label>
						<onclick>Seek(30)</onclick>
					</control>
					<control type="button" id="104">
						<include content="OSDButton"><param name="width" value="270"/></include>
						<label>$VAR[OSDAudioLabel]</label>
						<onclick>Action(AudioNextLanguage)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
					</control>
					<control type="button" id="105">
						<include content="OSDButton"><param name="width" value="270"/></include>
						<label>$VAR[OSDSubtitleLabel]</label>
						<onclick>Action(CycleSubtitle)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
					</control>
					<control type="button" id="107">
						<include content="OSDButton"><param name="width" value="250"/></include>
						<label>$ADDON[script.kscapex.wall 32274]</label>
						<onclick>RunScript(script.kscapex.wall,demo,prev)</onclick>
						<visible>!String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
					</control>
					<control type="button" id="108">
						<include content="OSDButton"><param name="width" value="220"/></include>
						<label>$ADDON[script.kscapex.wall 32275]</label>
						<onclick>RunScript(script.kscapex.wall,demo,next)</onclick>
						<visible>!String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
					</control>
					<control type="button" id="109">
						<include content="OSDButton"><param name="width" value="250"/></include>
						<label>$ADDON[script.kscapex.wall 32276]</label>
						<onclick>RunScript(script.kscapex.wall,demo,exit)</onclick>
						<visible>!String.IsEmpty(Window(Home).Property(kscape.demo.active))</visible>
					</control>
					<control type="button" id="110">
						<description>Scenes: mark the start, then the end (library movies and episodes)</description>
						<include content="OSDButton"><param name="width" value="280"/></include>
						<label>$VAR[OSDSceneLabel]</label>
						<onclick>Dialog.Close(videoosd)</onclick>
						<onclick>RunScript(script.kscapex.wall,scene,mark)</onclick>
						<visible>String.IsEmpty(Window(Home).Property(kscape.demo.active)) + !String.IsEmpty(VideoPlayer.DBID) + [VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)] + System.AddonIsEnabled(script.kscapex.wall)</visible>
					</control>
				</control>
				<control type="grouplist" id="200">
					<description>KScapeX: the settings and dialogs Kodi offers during playback</description>
					<left>120</left>
					<top>950</top>
					<width>1680</width>
					<height>70</height>
					<orientation>horizontal</orientation>
					<itemgap>16</itemgap>
					<align>center</align>
					<onup>100</onup>
					<control type="button" id="207">
						<description>Technical data: TinyPPI (script.tinyppi, CE-Repo) when it is installed and enabled -
						the full avdvplus overlay (Dolby Vision RPU/EL/CM version, L1/L5/L6 metadata, VS10,
						queues, Atmos objects...); its launch toggles it. Otherwise Kodi's player process info
						(top left). The OSD closes first, so the overlay is not under it and Kodi's action
						reaches the full-screen video, which toggles its dialog.</description>
						<include content="OSDButton"><param name="width" value="220"/></include>
						<label>$LOCALIZE[31090]</label>
						<onclick>Dialog.Close(videoosd,true)</onclick>
						<onclick condition="System.AddonIsEnabled(script.tinyppi)">RunAddon(script.tinyppi)</onclick>
						<onclick condition="!System.AddonIsEnabled(script.tinyppi)">Action(PlayerProcessInfo)</onclick>
					</control>
					<control type="button" id="201">
						<include content="OSDButton"><param name="width" value="225"/></include>
						<label>$LOCALIZE[31084]</label>
						<onclick>ActivateWindow(osdaudiosettings)</onclick>
					</control>
					<control type="button" id="202">
						<include content="OSDButton"><param name="width" value="225"/></include>
						<label>$LOCALIZE[31085]</label>
						<onclick>ActivateWindow(osdvideosettings)</onclick>
					</control>
					<control type="button" id="203">
						<include content="OSDButton"><param name="width" value="280"/></include>
						<label>$LOCALIZE[31086]</label>
						<onclick>ActivateWindow(osdsubtitlesettings)</onclick>
					</control>
					<control type="button" id="204">
						<include content="OSDButton"><param name="width" value="270"/></include>
						<label>$LOCALIZE[31087]</label>
						<onclick>ActivateWindow(subtitlesearch)</onclick>
					</control>
					<control type="button" id="205">
						<include content="OSDButton"><param name="width" value="170"/></include>
						<label>$LOCALIZE[31088]</label>
						<onclick>ActivateWindow(videobookmarks)</onclick>
						<visible>!VideoPlayer.Content(livetv)</visible>
					</control>
					<control type="button" id="206">
						<description>The movie's information over the video (the OSD closes first)</description>
						<include content="OSDButton"><param name="width" value="190"/></include>
						<label>$LOCALIZE[31089]</label>
						<onclick>Dialog.Close(videoosd,true)</onclick>
						<onclick>Action(Info)</onclick>
					</control>
				</control>
			</control>
	
		</control>
	</controls>
</window>
