<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by tools/gen_home_xml.py from the views' geometry. Do not edit by hand. -->
<includes>
	<!-- The view cards above the tabs named in CARD_KINDS (none in KScapeX): List, Covers,
	     Collections (and Now Playing for music), each the real view at 1/6 scale. Up from the tab
	     enters the cards; Down from the bottom card or Back returns to the bar. -->
	<include name="KScapeHomeCards">
		<definition>
		<control type="button" id="9030">
			<pulseonselect>false</pulseonselect>
			<description>Category router: Left/Right on a submenu (or a card) move the bar, then focus
			lands here and goes on to the new category's submenu (or cards, or the bar). Off screen
			but visible, so it can take focus.</description>
			<left>-200</left>
			<top>-200</top>
			<width>1</width>
			<height>1</height>
			<texturefocus/>
			<texturenofocus/>
			<onfocus condition="String.IsEqual(Container(9000).ListItem.Property(hassub),true)">SetFocus(9010)</onfocus>
			<onfocus condition="!String.IsEqual(Container(9000).ListItem.Property(hassub),true)">SetFocus(9000)</onfocus>
		</control>
		</definition>
	</include>

	<!-- What is playing, top right of Home: clear of the submenus, which rise from the
	     bottom. A video shows its artwork (KScapeX: no live videowindow). -->
	<include name="KScapeHomeNowPlaying">
		<definition>
			<control type="group">
				<left>1088</left>
				<top>118</top>
				<visible>Player.HasMedia</visible>
				<animation effect="fade" start="0" end="100" time="300">Visible</animation>
				<animation effect="fade" start="100" end="0" time="200">Hidden</animation>
				<control type="image">
					<left>88</left>
					<width>112</width>
					<height>112</height>
					<texture colordiffuse="FF1A1A1F">white.png</texture>
					<visible>Player.HasAudio</visible>
				</control>
				<control type="image">
					<left>88</left>
					<width>112</width>
					<height>112</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[Player.Art(thumb)]</texture>
					<visible>Player.HasAudio</visible>
				</control>
				<control type="image">
					<width>200</width>
					<height>112</height>
					<texture colordiffuse="FF000000">white.png</texture>
					<visible>Player.HasVideo</visible>
				</control>
				<control type="image">
					<description>Playing video: its artwork (no live videowindow: on the AM6B+ it kept the screen redrawing)</description>
					<width>200</width>
					<height>112</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[Player.Art(thumb)]</texture>
					<visible>Player.HasVideo</visible>
				</control>
				<control type="image">
					<description>Playing video: fanart over the thumb when there is one</description>
					<width>200</width>
					<height>112</height>
					<aspectratio>scale</aspectratio>
					<texture background="true">$INFO[Player.Art(fanart)]</texture>
					<visible>Player.HasVideo</visible>
				</control>
				<control type="label">
					<left>224</left>
					<top>0</top>
					<width>528</width>
					<height>28</height>
					<font>kscape_list_head</font>
					<textcolor>kscape_amber</textcolor>
					<label>$VAR[KScapePlayerState]</label>
				</control>
				<control type="label">
					<left>224</left>
					<top>28</top>
					<width>528</width>
					<height>40</height>
					<font>kscape_sub</font>
					<textcolor>white</textcolor>
					<label>$INFO[Player.Title]</label>
				</control>
				<control type="label">
					<left>224</left>
					<top>66</top>
					<width>528</width>
					<height>30</height>
					<font>kscape_small</font>
					<textcolor>kscape_text_dim</textcolor>
					<label>$VAR[KScapePlayerSubtitle]</label>
				</control>
				<control type="progress">
					<left>224</left>
					<top>102</top>
					<width>330</width>
					<height>6</height>
					<texturebg colordiffuse="kscape_blue_dark">white.png</texturebg>
					<midtexture colordiffuse="kscape_amber">white.png</midtexture>
					<info>Player.Progress</info>
				</control>
				<control type="label">
					<left>566</left>
					<top>90</top>
					<width>186</width>
					<height>28</height>
					<align>right</align>
					<font>kscape_badge</font>
					<textcolor>kscape_text_dim</textcolor>
					<label>$INFO[Player.Time]$INFO[Player.Duration, / ]</label>
				</control>
			</control>
		</definition>
	</include>
	<variable name="KScapePlayerState">
		<value condition="Player.Paused">$LOCALIZE[31056]</value>
		<value>$LOCALIZE[31055]</value>
	</variable>
	<variable name="KScapePlayerSubtitle">
		<value condition="Player.HasAudio">$INFO[MusicPlayer.Artist]$INFO[MusicPlayer.Album,  ·  ]</value>
		<value condition="VideoPlayer.Content(episodes)">$INFO[VideoPlayer.TVShowTitle]$INFO[VideoPlayer.Season,  ·  S]$INFO[VideoPlayer.Episode,E]</value>
		<value>$INFO[VideoPlayer.Year]</value>
	</variable>
	<variable name="KScapePlayerPoster">
		<value condition="VideoPlayer.Content(episodes) + !String.IsEmpty(Player.Art(tvshow.poster))">$INFO[Player.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(Player.Art(poster))">$INFO[Player.Art(poster)]</value>
		<value>$INFO[Player.Art(thumb)]</value>
	</variable>
</includes>
